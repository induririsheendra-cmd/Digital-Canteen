# Next.js Server Configuration
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="any_long_random_secret_key_for_session_encryption"

# Local PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://postgres:local_db_password_123@localhost:5432/digital_canteen"
DIRECT_URL="postgresql://postgres:local_db_password_123@localhost:5432/digital_canteen"

# Google Cloud OAuth Credentials (For Google Sign-In, optional for offline guest credential logins)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Razorpay Credentials (For Payment Processing, optional for local testing)
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
